# Copy to .env and fill in. Never commit the filled-in file.

# ---- LLM (https://console.groq.com) ----
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=Gemma2-9b-It
LLM_TEMPERATURE=0.3

# ---- Embeddings ----
# "voyage" = hosted, free tier (200M tokens), no card. MongoDB's own provider.
# "openai" = hosted, paid.
# "local"  = sentence-transformers, free and offline, installs torch (~2GB).
#            Cannot run on serverless or on small instances.
EMBEDDING_PROVIDER=voyage

# Free key, no card required: https://dashboard.voyageai.com
VOYAGE_API_KEY=pa-your_key_here
VOYAGE_EMBEDDING_MODEL=voyage-3-lite

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- MongoDB ----
# Use a READ-ONLY Atlas user scoped to the menu database.
# Do not reuse the admin credentials from the Banchan project.
# MONGODB_URI is accepted as an alias.
MONGO_URI=mongodb+srv://rag_readonly:PASSWORD@your-cluster.mongodb.net
# The menu-service database: menuitems, categories, restaurants.
MONGO_DB=menu

# ---- Retrieval ----
RETRIEVAL_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---- Agent ----
MAX_TOOL_ITERATIONS=8

# ---- Server ----
PORT=8000
# Comma-separated. Add your deployed frontend origin in production.
CORS_ORIGINS=http://localhost:3000
